# ---------------------------------------------------------------------------
# Database — Postgres
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT: `docker compose up -d` starts the container defined in
# docker-compose.yml, then use exactly this value:
#
#   DATABASE_URL=postgres://clothshop:devpassword@localhost:5432/clothshop
#
# RAILWAY: attach a Postgres service and Railway injects DATABASE_URL for you.
# Prefer the PRIVATE URL (`*.railway.internal`) — it keeps traffic off the
# public internet and costs no egress. The app detects the host and disables
# SSL for private/local URLs, enabling it for public ones (src/db/index.ts).
DATABASE_URL=

# Auth.js v5 — random secret used to sign session JWTs. Generate with:
#   npx auth secret
AUTH_SECRET=

# Auth.js v5 — the canonical URL of this deployment (used to build
# callback/redirect URLs). http://localhost:3000 in development.
AUTH_URL=

# ---------------------------------------------------------------------------
# Object storage — product images
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT: `docker compose up -d`
# also starts MinIO, an S3-compatible server, and creates a public-read
# `clothshop` bucket. Use exactly these five values and the real upload flow
# (browser resize -> presigned PUT -> public GET) works end to end:
#
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY_ID=minioadmin
#   STORAGE_SECRET_ACCESS_KEY=minioadmin
#   STORAGE_BUCKET=clothshop
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=true
#
# RAILWAY: create a Bucket and add references from its Credentials tab:
#   STORAGE_ENDPOINT=${{Bucket.ENDPOINT}}
#   STORAGE_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
#   STORAGE_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
#   STORAGE_BUCKET=${{Bucket.BUCKET}}
#   STORAGE_REGION=${{Bucket.REGION}}
#   STORAGE_FORCE_PATH_STYLE=false
# Replace `Bucket` with the service's exact display name. Product images are
# served at /api/images/*, so the private bucket needs no public URL.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false

# Canonical public site URL — used for sitemap.xml, robots.txt, absolute
# metadata URLs, and JSON-LD. Exposed to the client.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Account email — Resend (disabled until a sending domain is available)
# ---------------------------------------------------------------------------
# Keep false to auto-verify new customer accounts and hide verification/reset
# email controls. To enable later, set all three values and use a verified
# sender address in Resend. AUTH_URL or NEXT_PUBLIC_SITE_URL is used in links.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
