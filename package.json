{
  "name": "clothshop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.8.1"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "npm run db:seed:types && npm run db:seed:characters",
    "db:seed:types": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed:characters": "tsx --env-file-if-exists=.env.local scripts/seed-characters.ts",
    "catalog:prepare": "tsx --env-file-if-exists=.env.local scripts/catalog-prepare.ts",
    "catalog:verify": "tsx --env-file-if-exists=.env.local scripts/catalog-verify.ts",
    "catalog:import": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/catalog-import.ts",
    "catalog:repair-images": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/catalog-repair-images.ts",
    "create-owner": "tsx --env-file-if-exists=.env.local scripts/create-owner.ts",
    "smoke": "./scripts/smoke.sh",
    "test": "tsx --test src/lib/catalog/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.906.0",
    "@aws-sdk/s3-request-presigner": "^3.906.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.2",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
